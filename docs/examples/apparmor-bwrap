# AppArmor profile for Ubuntu 23.10+/24.04 hosts that set
# kernel.apparmor_restrict_unprivileged_userns=1 (the Ubuntu default).
# It lets only /usr/bin/bwrap create the user namespaces Kinaiya's Agent sandbox
# requires; the global restriction stays enabled for every other program.
# Install as an administrator, after review:
#   sudo install -m 0644 apparmor-bwrap /etc/apparmor.d/kinaiya-bwrap
#   sudo apparmor_parser -r /etc/apparmor.d/kinaiya-bwrap
abi <abi/4.0>,
include <tunables/global>

profile kinaiya-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/kinaiya-bwrap>
}
