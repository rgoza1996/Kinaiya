+#include "../tools/server/server-realtime-history.h"
+
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+
+struct legacy_prefix : server_realtime_turn_text {
+    std::string instructions;
+    std::function<std::string(const std::vector<common_chat_msg> &, bool)> render;
+#include "realtime-history-8ca4060.inc"
+};
+
+static void require(bool value, const char * message) {
+    if (!value) {
+        throw std::runtime_error(message);
+    }
+}
+
+static common_chat_msg message(const std::string & role, const std::string & content) {
+    common_chat_msg value;
+    value.role = role;
+    value.content = content;
+    return value;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        require(argc == 1 || argc == 2 || argc == 4, "invalid template-test arguments");
+        std::vector<std::string> templates = {
+            "{% for m in messages %}<|im_start|>{{ m['role'] }}\n{{ m['content'] }}<|im_end|>\n{% endfor %}"
+            "{% if add_generation_prompt %}<|im_start|>assistant\n{% endif %}"
+        };
+        if (argc == 2 || argc == 4) {
+            std::ifstream file(argv[1]);
+            require(file.good(), "template unavailable");
+            std::ostringstream text;
+            text << file.rdbuf();
+            templates.push_back(text.str());
+        }
+        int checks = 0;
+        for (const auto & text : templates) {
+            auto tmpls = common_chat_templates_init(nullptr, text, argc == 4 ? argv[2] : "", argc == 4 ? argv[3] : "");
+            auto render = [&](const std::vector<common_chat_msg> & messages, bool generation) {
+                common_chat_templates_inputs input;
+                input.messages = messages;
+                input.use_jinja = true;
+                input.enable_thinking = false;
+                input.add_generation_prompt = generation;
+                return common_chat_templates_apply(tmpls.get(), input).prompt.str();
+            };
+            const std::vector<std::vector<common_chat_msg>> prefixes = {
+                {},
+                {message("system", "Public character.")},
+                {message("system", "Literal @@USER@@ stays in the system."),
+                 message("user", "Public first question."), message("assistant", "Generated reply; delivery unknown.")},
+                {message("system", "Public character: @@USER@@ / @@REPLY@@"),
+                 message("user", "café / quoted \"data\" / newline\n"), message("assistant", "Public previous reply."),
+                 message("system", "Additional authorized system row.")},
+                {message("system", "@@NATIVE_public_seed_USER@@ remains literal data.")},
+            };
+            for (const auto & prefix : prefixes) {
+                server_realtime_turn_text actual;
+                const std::string seed = "independent_seed";
+                require(server_realtime_derive_turn_text(prefix, render, seed, actual), "turn derivation refused");
+                auto current = prefix;
+                current.push_back(message("user", "PUBLIC-CURRENT-AUDIO-PLACEHOLDER"));
+                const auto expected = render(current, false);
+                require(actual.first_header + "PUBLIC-CURRENT-AUDIO-PLACEHOLDER" + actual.user_footer == expected,
+                        "full first-turn prefix differs from actual chat template");
+                require(expected + actual.assistant_header == render(current, true), "assistant generation header differs");
+                checks += 2;
+            }
+            server_realtime_turn_text untouched;
+            untouched.first_header = "unchanged";
+            require(!server_realtime_derive_turn_text(prefixes.back(), render, "public_seed", untouched),
+                    "colliding marker must refuse before changing prefix");
+            require(untouched.first_header == "unchanged", "refused derivation mutated prefix");
+            checks += 2;
+            legacy_prefix old;
+            old.instructions = "Literal @@USER@@ belongs in this system instruction.";
+            old.render = render;
+            const auto expected_old = render({message("system", old.instructions),
+                                              message("user", "PUBLIC-CURRENT-AUDIO-PLACEHOLDER")}, false);
+            const bool old_fidelity = old.derive_turn_text() &&
+                old.first_header + "PUBLIC-CURRENT-AUDIO-PLACEHOLDER" + old.user_footer == expected_old;
+            require(!old_fidelity, "original-placeholder negative control unexpectedly qualified");
+            std::cout << "original_8ca4060_prefix_fidelity=false\n";
+            ++checks;
+            std::cout << "template_sha256=" << hash_sha256_hex(text.data(), text.size()) << "\n";
+        }
+        std::vector<common_chat_msg> history;
+        const auto input = common_json::parse("[{\"role\":\"user\",\"content\":\"café / \\\"quoted\\\"\\n\"},{\"content\":\"reply\",\"role\":\"assistant\"}]");
+        require(server_realtime_parse_history(input, "Public system.", history), "valid typed history refused");
+        require(history.size() == 2 && history[0].role == "user" && history[1].role == "assistant", "roles/order changed");
+        std::cout << "history_sha256=" << server_realtime_history_digest(history) << "\n";
+        for (const auto & bad : {"{}", "[{}]", "[{\"role\":\"tool\",\"content\":\"x\"}]",
+                               "[{\"role\":\"user\",\"content\":1}]", "[{\"role\":\"user\",\"content\":\"x\",\"extra\":1}]"}) {
+            auto previous = history;
+            require(!server_realtime_parse_history(common_json::parse(bad), "Public system.", history), "malformed history accepted");
+            require(server_realtime_history_json(history).dump() == server_realtime_history_json(previous).dump(), "refusal mutated history");
+            checks += 2;
+        }
+        require(server_realtime_history_contract(server_realtime_history_capabilities()), "own capability refused");
+        require(!server_realtime_history_contract(common_json::parse("{\"contract\":\"native_history.v2\",\"max_messages\":4094,\"max_utf8_bytes\":1048576}")), "future capability accepted");
+        std::cout << "checks_passed=" << checks + 4 << "\n";
+        return 0;
+    } catch (const std::exception & error) {
+        std::cerr << error.what() << "\n";
+        return 1;
+    }
+}
