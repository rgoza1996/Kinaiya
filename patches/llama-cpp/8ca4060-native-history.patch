@@ -0,0 +1,123 @@
+#pragma once
+
+#include "chat.h"
+#include "json.h"
+#include "hash/hash.h"
+
+#include <string>
+#include <vector>
+
+constexpr size_t SERVER_REALTIME_HISTORY_MESSAGES = 4094;
+constexpr size_t SERVER_REALTIME_HISTORY_BYTES = 1024 * 1024;
+
+inline common_json server_realtime_history_capabilities() {
+    return {{"contract", "native_history.v1"},
+            {"max_messages", SERVER_REALTIME_HISTORY_MESSAGES},
+            {"max_utf8_bytes", SERVER_REALTIME_HISTORY_BYTES}};
+}
+
+inline bool server_realtime_history_contract(const common_json & value) {
+    return value.is_object() && value.size() == 3 &&
+        value.contains("contract") && value["contract"] == "native_history.v1" &&
+        value.contains("max_messages") && value["max_messages"].is_number_integer() &&
+        value["max_messages"].get<int64_t>() == SERVER_REALTIME_HISTORY_MESSAGES &&
+        value.contains("max_utf8_bytes") && value["max_utf8_bytes"].is_number_integer() &&
+        value["max_utf8_bytes"].get<int64_t>() == SERVER_REALTIME_HISTORY_BYTES;
+}
+
+inline common_json server_realtime_history_json(const std::vector<common_chat_msg> & history) {
+    auto value = common_json::array();
+    for (const auto & message : history) {
+        // common_json preserves insertion order: these keys must be sorted to
+        // match the versioned compact UTF-8 JSON digest used by the client.
+        value.push_back(common_json{{"content", message.content}, {"role", message.role}});
+    }
+    return value;
+}
+
+inline std::string server_realtime_history_digest(const std::vector<common_chat_msg> & history) {
+    const auto encoded = server_realtime_history_json(history).dump();
+    return hash_sha256_hex(encoded.data(), encoded.size());
+}
+
+inline bool server_realtime_parse_history(const common_json & value, const std::string & instructions,
+                                         std::vector<common_chat_msg> & result) {
+    if (!value.is_array() || value.size() > SERVER_REALTIME_HISTORY_MESSAGES ||
+        instructions.size() > SERVER_REALTIME_HISTORY_BYTES) {
+        return false;
+    }
+    size_t bytes = instructions.size() + 2; // brackets of the canonical array
+    std::vector<common_chat_msg> parsed;
+    for (const auto & item : value) {
+        if (!item.is_object() || item.size() != 2 || !item.contains("role") || !item.contains("content") ||
+            !item["role"].is_string() || !item["content"].is_string()) {
+            return false;
+        }
+        common_chat_msg message;
+        message.role = item["role"].get<std::string>();
+        message.content = item["content"].get<std::string>();
+        if ((message.role != "system" && message.role != "user" && message.role != "assistant") ||
+            message.content.size() > SERVER_REALTIME_HISTORY_BYTES) {
+            return false;
+        }
+        const common_json row = {{"content", message.content}, {"role", message.role}};
+        bytes += row.dump().size() + (parsed.empty() ? 0 : 1);
+        if (bytes > SERVER_REALTIME_HISTORY_BYTES) {
+            return false;
+        }
+        parsed.push_back(std::move(message));
+    }
+    if (bytes > SERVER_REALTIME_HISTORY_BYTES) {
+        return false;
+    }
+    result = std::move(parsed);
+    return true;
+}
+
+struct server_realtime_turn_text {
+    std::string first_header;
+    std::string user_header;
+    std::string user_footer;
+    std::string assistant_header;
+    std::string assistant_footer;
+};
+
+template <typename Render>
+bool server_realtime_derive_turn_text(const std::vector<common_chat_msg> & prefix, Render render,
+                                     const std::string & nonce, server_realtime_turn_text & result) {
+    const std::string user = "@@NATIVE_" + nonce + "_USER@@";
+    const std::string reply = "@@NATIVE_" + nonce + "_REPLY@@";
+    for (const auto & message : prefix) {
+        if (message.content.find(user) != std::string::npos || message.content.find(reply) != std::string::npos) {
+            return false;
+        }
+    }
+    auto msg = [](const char * role, const std::string & content) {
+        common_chat_msg value;
+        value.role = role;
+        value.content = content;
+        return value;
+    };
+    auto with = [&](std::vector<common_chat_msg> rest, bool generation = false) {
+        auto all = prefix;
+        all.insert(all.end(), rest.begin(), rest.end());
+        return render(all, generation);
+    };
+    const std::string a = with({msg("user", user)});
+    const std::string g = with({msg("user", user)}, true);
+    const std::string c = with({msg("user", user), msg("assistant", reply)});
+    const std::string d = with({msg("user", user), msg("assistant", reply), msg("user", user)});
+    const size_t pa = a.find(user);
+    const size_t pc = c.find(reply);
+    const size_t pd = d.find(user, c.size());
+    if (pa == std::string::npos || pc == std::string::npos || pd == std::string::npos ||
+        a.find(user, pa + user.size()) != std::string::npos ||
+        c.find(reply, pc + reply.size()) != std::string::npos ||
+        c.compare(0, a.size(), a) != 0 || d.compare(0, c.size(), c) != 0 ||
+        g.compare(0, a.size(), a) != 0 || pc < a.size()) {
+        return false;
+    }
+    result = {a.substr(0, pa), d.substr(c.size(), pd - c.size()), a.substr(pa + user.size()),
+              g.substr(a.size()), c.substr(pc + reply.size())};
+    return true;
+}
