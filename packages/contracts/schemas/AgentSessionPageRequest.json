{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "channel": {
      "const": "agent",
      "default": "agent",
      "title": "Channel",
      "type": "string"
    },
    "harness_version": {
      "anyOf": [
        {
          "pattern": "^(seed-v1|v-[a-f0-9]{24}|unassociated)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness Version"
    },
    "after": {
      "anyOf": [
        {
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After"
    },
    "limit": {
      "default": 20,
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "title": "AgentSessionPageRequest",
  "type": "object"
}
