{
  "$defs": {
    "MediaAudioFormat": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "codec": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "raw",
            "wav"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "const": "audio",
          "title": "Kind",
          "type": "string"
        },
        "rate": {
          "enum": [
            16000,
            24000,
            48000
          ],
          "title": "Rate",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "container",
        "codec",
        "rate",
        "channels"
      ],
      "title": "MediaAudioFormat",
      "type": "object"
    },
    "MediaClipFormat": {
      "additionalProperties": false,
      "properties": {
        "audio_codec": {
          "enum": [
            "aac",
            "opus",
            "none"
          ],
          "title": "Audio Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "mp4",
            "webm"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "const": "video_clip",
          "title": "Kind",
          "type": "string"
        },
        "video_codec": {
          "enum": [
            "h264",
            "hevc",
            "vp9",
            "av1"
          ],
          "title": "Video Codec",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "container",
        "video_codec",
        "audio_codec"
      ],
      "title": "MediaClipFormat",
      "type": "object"
    },
    "MediaImageFormat": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "enum": [
            "png",
            "mjpeg"
          ],
          "title": "Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "png",
            "jpeg"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video_frame"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pixel_format": {
          "const": "rgb24",
          "title": "Pixel Format",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "container",
        "codec",
        "pixel_format"
      ],
      "title": "MediaImageFormat",
      "type": "object"
    },
    "MediaQ": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "MediaQ",
      "type": "object"
    },
    "MediaSignedQ": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "MediaSignedQ",
      "type": "object"
    },
    "MediaTrack": {
      "additionalProperties": false,
      "properties": {
        "clock_provenance": {
          "enum": [
            "container",
            "native_capture",
            "native_audio_samples",
            "client_reported",
            "provider_reported",
            "untimed_image"
          ],
          "title": "Clock Provenance",
          "type": "string"
        },
        "command_lane": {
          "title": "Command Lane",
          "type": "boolean"
        },
        "common_origin": {
          "$ref": "#/$defs/MediaSignedQ"
        },
        "format_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Format Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "audio",
            "video",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Source Id",
          "type": "string"
        },
        "timebase": {
          "$ref": "#/$defs/MediaQ"
        },
        "track_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "source_id",
        "kind",
        "format_sha256",
        "timebase",
        "common_origin",
        "clock_provenance",
        "command_lane"
      ],
      "title": "MediaTrack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "discriminator": {
        "mapping": {
          "audio": "#/$defs/MediaAudioFormat",
          "image": "#/$defs/MediaImageFormat",
          "video_clip": "#/$defs/MediaClipFormat",
          "video_frame": "#/$defs/MediaImageFormat"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MediaAudioFormat"
        },
        {
          "$ref": "#/$defs/MediaImageFormat"
        },
        {
          "$ref": "#/$defs/MediaClipFormat"
        }
      ],
      "title": "Format"
    },
    "probe_index": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Probe Index",
      "type": "integer"
    },
    "track": {
      "$ref": "#/$defs/MediaTrack"
    }
  },
  "required": [
    "probe_index",
    "track",
    "format"
  ],
  "title": "MediaDecodeSelection",
  "type": "object"
}
