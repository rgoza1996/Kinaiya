{
  "$defs": {
    "AgentModelPin": {
      "additionalProperties": false,
      "description": "Native model selection for one accepted task; never request authority.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "local": {
          "title": "Local",
          "type": "boolean"
        },
        "reasoning": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "settings_revision": {
          "minimum": 0,
          "title": "Settings Revision",
          "type": "integer"
        },
        "catalog_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogModelBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_revision": {
          "anyOf": [
            {
              "maximum": 9007199254740990,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Revision"
        }
      },
      "required": [
        "profile_id",
        "provider",
        "model",
        "local",
        "settings_revision"
      ],
      "title": "AgentModelPin",
      "type": "object"
    },
    "CatalogModelBinding": {
      "additionalProperties": false,
      "description": "Explicit immutable native provider reference, never a display alias.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "generation": {
          "maximum": 64,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation",
        "configuration_sha256"
      ],
      "title": "CatalogModelBinding",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "command",
            "read",
            "search",
            "test",
            "extension",
            "external",
            "artifact",
            "inspection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "output": {
          "default": "",
          "title": "Output",
          "type": "string"
        },
        "objective_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Objective Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "accepted",
        "queued",
        "running",
        "verifying",
        "awaiting_approval",
        "blocked",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "paused"
      ],
      "title": "TaskState",
      "type": "string"
    },
    "WorkspacePin": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Workspace Id",
          "type": "string"
        },
        "root_identity": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Root Identity",
          "type": "string"
        },
        "settings_revision": {
          "maximum": 9007199254740990,
          "minimum": 0,
          "title": "Settings Revision",
          "type": "integer"
        },
        "source": {
          "enum": [
            "host",
            "owner_saved"
          ],
          "title": "Source",
          "type": "string"
        },
        "shell_backend": {
          "const": "bubblewrap",
          "title": "Shell Backend",
          "type": "string"
        },
        "mode": {
          "const": "direct",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "root_identity",
        "settings_revision",
        "source",
        "shell_backend",
        "mode"
      ],
      "title": "WorkspacePin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "content_scope": {
      "default": "local_only",
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Content Scope",
      "type": "string"
    },
    "objective_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "accepted"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "remaining_required_work": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Required Work",
      "type": "array"
    },
    "source_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Event Ids",
      "type": "array"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "harness_version": {
      "default": "seed-v1",
      "title": "Harness Version",
      "type": "string"
    },
    "model_pin": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentModelPin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "auxiliary_models": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentModelPin"
      },
      "maxProperties": 5,
      "propertyNames": {
        "enum": [
          "analysis",
          "compression",
          "title_generation",
          "delegation",
          "harness_design"
        ]
      },
      "title": "Auxiliary Models",
      "type": "object"
    },
    "workspace_pin": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspacePin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "session_id",
    "thread_id",
    "epoch",
    "objective",
    "idempotency_key"
  ],
  "title": "Task",
  "type": "object"
}
