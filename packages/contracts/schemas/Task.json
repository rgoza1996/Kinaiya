{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "command",
            "read",
            "search",
            "test",
            "extension"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "output": {
          "default": "",
          "title": "Output",
          "type": "string"
        },
        "objective_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Objective Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "accepted",
        "queued",
        "running",
        "verifying",
        "awaiting_approval",
        "blocked",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "paused"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "objective_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "accepted"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "remaining_required_work": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Required Work",
      "type": "array"
    },
    "source_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Event Ids",
      "type": "array"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "harness_version": {
      "default": "seed-v1",
      "title": "Harness Version",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "session_id",
    "thread_id",
    "epoch",
    "objective",
    "idempotency_key"
  ],
  "title": "Task",
  "type": "object"
}
