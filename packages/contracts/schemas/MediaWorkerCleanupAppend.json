{
  "$defs": {
    "MediaConsumerRef": {
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Consumer Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "consumer_id",
        "generation"
      ],
      "title": "MediaConsumerRef",
      "type": "object"
    },
    "MediaFence": {
      "additionalProperties": false,
      "properties": {
