        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch"
      ],
