      "maxLength": 256,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaNativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    },
    "value": {
      "$ref": "#/$defs/MediaWorkerCleanup"
