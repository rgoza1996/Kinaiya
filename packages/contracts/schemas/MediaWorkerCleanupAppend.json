      "type": "object"
    },
    "MediaWorkerCleanup": {
      "additionalProperties": false,
      "properties": {
        "binding_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
