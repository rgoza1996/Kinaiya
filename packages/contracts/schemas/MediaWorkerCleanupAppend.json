          "title": "Scope",
          "type": "string"
        },
        "state": {
          "enum": [
            "settled",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "kind",
        "operation_id",
        "child_instance",
        "binding_sha256",
        "original_owner",
        "state",
        "outcome",
        "proof",
        "publication",
        "scope"
      ],
      "title": "MediaWorkerCleanup",
      "type": "object"
