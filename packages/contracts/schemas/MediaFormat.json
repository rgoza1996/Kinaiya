{
  "$defs": {
    "MediaAudioFormat": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "codec": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "raw",
            "wav"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "const": "audio",
          "title": "Kind",
          "type": "string"
        },
        "rate": {
          "enum": [
            16000,
            24000,
            48000
          ],
          "title": "Rate",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "container",
        "codec",
        "rate",
        "channels"
      ],
      "title": "MediaAudioFormat",
      "type": "object"
    },
    "MediaClipFormat": {
      "additionalProperties": false,
      "properties": {
        "audio_codec": {
          "enum": [
            "aac",
            "opus",
            "none"
          ],
          "title": "Audio Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "mp4",
            "webm"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "const": "video_clip",
          "title": "Kind",
          "type": "string"
        },
        "video_codec": {
          "enum": [
            "h264",
            "hevc",
            "vp9",
            "av1"
          ],
          "title": "Video Codec",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "container",
        "video_codec",
        "audio_codec"
      ],
      "title": "MediaClipFormat",
      "type": "object"
    },
    "MediaImageFormat": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "enum": [
            "png",
            "mjpeg"
          ],
          "title": "Codec",
          "type": "string"
        },
        "container": {
          "enum": [
            "png",
            "jpeg"
          ],
          "title": "Container",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video_frame"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pixel_format": {
          "const": "rgb24",
          "title": "Pixel Format",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "container",
        "codec",
        "pixel_format"
      ],
      "title": "MediaImageFormat",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "audio": "#/$defs/MediaAudioFormat",
      "image": "#/$defs/MediaImageFormat",
      "video_clip": "#/$defs/MediaClipFormat",
      "video_frame": "#/$defs/MediaImageFormat"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MediaAudioFormat"
    },
    {
      "$ref": "#/$defs/MediaImageFormat"
    },
    {
      "$ref": "#/$defs/MediaClipFormat"
    }
  ]
}
