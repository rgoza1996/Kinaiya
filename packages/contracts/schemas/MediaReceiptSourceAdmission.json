        "fence": {
          "$ref": "#/$defs/MediaFence"
        },
        "kind": {
          "enum": [
            "recording",
            "live"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lease_expires_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Lease Expires At Ms",
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "owner_voice",
            "observe",
            "analyze"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "raw_retain_until_ms": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Retain Until Ms"
        },
        "replaces_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaNativeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservation": {
          "$ref": "#/$defs/MediaReservation"
        },
        "scope": {
          "enum": [
            "local_only",
            "public_synthetic",
            "private_cloud_authorized"
          ],
          "title": "Scope",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/MediaSession"
        },
        "source_equivalence_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 32,
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Equivalence Id"
        },
        "source_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "admission_id",
        "source_id",
        "source_equivalence_id",
        "source_revision",
        "session",
        "kind",
        "purpose",
        "anchor",
        "replaces_source",
        "capture_instance",
        "client_instance",
        "scope",
        "reservation",
        "decoder_profile_sha256",
        "fence",
        "lease_expires_at_ms",
        "raw_retain_until_ms"
      ],
      "title": "MediaSourceAdmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/MediaSourceAdmission"
    },
    "id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "title": "Id",
      "type": "string"
    },
    "key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "id",
    "key",
    "request_sha256",
    "body",
    "sha256"
  ],
  "title": "MediaReceipt[MediaSourceAdmission]",
  "type": "object"
}
