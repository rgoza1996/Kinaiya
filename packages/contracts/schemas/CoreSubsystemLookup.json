{
  "$defs": {
    "CoreSubsystemReceipt": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "core_subsystems.v1",
          "default": "core_subsystems.v1",
          "title": "Contract",
          "type": "string"
        },
        "status": {
          "const": "saved",
          "default": "saved",
          "title": "Status",
          "type": "string"
        },
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[a-f0-9]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "authority_epoch": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[a-f0-9]{32}$",
          "title": "Authority Epoch",
          "type": "string"
        },
        "authority_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Authority Generation",
          "type": "integer"
        },
        "revision": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:._-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/CoreSubsystemSelection"
        },
        "host_mode_observed": {
          "anyOf": [
            {
              "enum": [
                "core",
                "agent",
                "decisions",
                "agent-decisions",
                "converse-decisions",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Host Mode Observed"
        },
        "selected_mode_observed": {
          "anyOf": [
            {
              "enum": [
                "core",
                "agent",
                "decisions",
                "agent-decisions",
                "converse-decisions",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Mode Observed"
        },
        "change_boundary": {
          "const": "next_managed_host_launch",
          "default": "next_managed_host_launch",
          "title": "Change Boundary",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "authority_epoch",
        "authority_generation",
        "revision",
        "idempotency_key",
        "selection",
        "host_mode_observed",
        "selected_mode_observed"
      ],
      "title": "CoreSubsystemReceipt",
      "type": "object"
    },
    "CoreSubsystemSelection": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "host",
            "saved"
          ],
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "core",
                "agent",
                "decisions",
                "agent-decisions",
                "converse-decisions",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "required": [
        "source"
      ],
      "title": "CoreSubsystemSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "core_subsystems.v1",
      "default": "core_subsystems.v1",
      "title": "Contract",
      "type": "string"
    },
    "backend_id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Backend Id",
      "type": "string"
    },
    "authority_epoch": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Authority Epoch",
      "type": "string"
    },
    "authority_generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Authority Generation",
      "type": "integer"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "saved",
        "unobserved"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoreSubsystemReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation_fenced": {
      "title": "Mutation Fenced",
      "type": "boolean"
    }
  },
  "required": [
    "backend_id",
    "authority_epoch",
    "authority_generation",
    "request_sha256",
    "outcome",
    "receipt",
    "mutation_fenced"
  ],
  "title": "CoreSubsystemLookup",
  "type": "object"
}
