          "type": "string"
        },
        "publication": {
          "enum": [
            "settled",
            "unknown"
          ],
          "title": "Publication",
          "type": "string"
        },
        "scope": {
          "enum": [
            "native_task",
            "local_process",
            "owned_worker",
            "client_playback",
            "external_unknown"
