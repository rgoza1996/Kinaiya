        "binding_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "child_instance": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Child Instance",
          "type": "string"
        },
        "kind": {
          "const": "native_owner",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "original_owner": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "outcome": {
