          "title": "All Readers Settled",
          "type": "boolean"
        },
        "binding_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "body_fd_closed": {
          "title": "Body Fd Closed",
          "type": "boolean"
        },
        "child_instance": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Child Instance",
          "type": "string"
        },
        "exchange_owner": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "kind": {
          "const": "local_exchange",
          "title": "Kind",
          "type": "string"
        },
        "local_task_joined": {
          "title": "Local Task Joined",
          "type": "boolean"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/MediaNativeRef"
          },
          "maxItems": 64,
          "title": "Observations",
          "type": "array"
        },
        "operation_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "original_owner": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "cancelled",
                "failed",
                "not_started"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "publications_settled": {
          "title": "Publications Settled",
          "type": "boolean"
        },
        "remote_liability": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "state": {
          "enum": [
            "settled",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "transport_sole_closed": {
          "title": "Transport Sole Closed",
          "type": "boolean"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "kind",
        "operation_id",
        "child_instance",
        "binding_sha256",
        "original_owner",
        "exchange_owner",
        "state",
        "outcome",
        "local_task_joined",
        "transport_sole_closed",
        "body_fd_closed",
        "all_readers_settled",
        "publications_settled",
        "observations",
        "remote_liability"
      ],
      "title": "MediaLocalExchangeCleanup",
      "type": "object"
    },
    "MediaNativeRef": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Receipt Id",
