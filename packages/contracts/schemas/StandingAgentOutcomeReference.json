{
  "additionalProperties": false,
  "description": "Plain-SHA references to captured complete native bytes, not work proof.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "title": "Task Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "objective_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "entry_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Entry Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "event_id",
    "sequence",
    "objective_revision",
    "state",
    "request_sha256",
    "entry_sha256"
  ],
  "title": "StandingAgentOutcomeReference",
  "type": "object"
}
