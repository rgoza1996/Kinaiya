{
  "$defs": {
    "MemoryCapture": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "assertion",
            "observation",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Event Id",
          "type": "string"
        },
        "source_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "fact": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryFact"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisite_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Prerequisite Ids",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch",
        "expected_revision",
        "idempotency_key",
        "kind",
        "source_event_id",
        "source_revision",
        "body",
        "fact"
      ],
      "title": "MemoryCapture",
      "type": "object"
    },
    "MemoryFact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "MemoryFact",
      "type": "object"
    },
    "MemoryForget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch",
        "expected_revision",
        "idempotency_key",
        "node_id"
      ],
      "title": "MemoryForget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "operation": {
      "enum": [
        "capture",
        "forget"
      ],
      "title": "Operation",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryCapture"
        },
        {
          "$ref": "#/$defs/MemoryForget"
        }
      ],
      "title": "Request"
    }
  },
  "required": [
    "operation",
    "request"
  ],
  "title": "MemoryOperationLookup",
  "type": "object"
}
