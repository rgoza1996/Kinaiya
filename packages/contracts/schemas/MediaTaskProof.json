{
  "$defs": {
    "MediaNativeRef": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "receipt_id",
        "sha256"
      ],
      "title": "MediaNativeRef",
      "type": "object"
    },
    "MediaOwnerMediaObjective": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "kind": {
          "const": "owner_media",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "intent"
      ],
      "title": "MediaOwnerMediaObjective",
      "type": "object"
    },
    "MediaOwnerTextObjective": {
      "additionalProperties": false,
      "properties": {
        "event_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Event Ref",
          "type": "string"
        },
        "kind": {
          "const": "owner_text",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event_ref"
      ],
      "title": "MediaOwnerTextObjective",
      "type": "object"
    },
    "MediaSession": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch"
      ],
      "title": "MediaSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "objective_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "original_admission_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Original Admission Id",
      "type": "string"
    },
    "owner_objective": {
      "discriminator": {
        "mapping": {
          "owner_media": "#/$defs/MediaOwnerMediaObjective",
          "owner_text": "#/$defs/MediaOwnerTextObjective"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MediaOwnerTextObjective"
        },
        {
          "$ref": "#/$defs/MediaOwnerMediaObjective"
        }
      ],
      "title": "Owner Objective"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "session": {
      "$ref": "#/$defs/MediaSession"
    },
    "state": {
      "enum": [
        "accepted",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "session",
    "task_id",
    "objective_revision",
    "owner_objective",
    "request_sha256",
    "original_admission_id",
    "state"
  ],
  "title": "MediaTaskProof",
  "type": "object"
}
