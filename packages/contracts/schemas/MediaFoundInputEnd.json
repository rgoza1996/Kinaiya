{
  "$defs": {
    "MediaFence": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "lease_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Lease Generation",
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/MediaSession"
        },
        "source_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        }
      },
      "required": [
        "session",
        "source_revision",
        "generation",
        "lease_generation"
      ],
      "title": "MediaFence",
      "type": "object"
    },
    "MediaInputEnd": {
      "additionalProperties": false,
      "properties": {
        "capture_ready": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaNativeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "decoder_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaNativeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence": {
          "$ref": "#/$defs/MediaFence"
        },
        "kind": {
          "enum": [
            "finite_eof",
            "capture_closed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "seal": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaNativeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "through_source_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Through Source Seq",
          "type": "integer"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/MediaTrackEnd"
          },
          "maxItems": 8,
          "title": "Tracks",
          "type": "array"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "source",
        "fence",
        "kind",
        "seal",
        "capture_ready",
        "decoder_end",
        "tracks",
        "through_source_seq"
      ],
      "title": "MediaInputEnd",
      "type": "object"
    },
    "MediaNativeRef": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "receipt_id",
        "sha256"
      ],
      "title": "MediaNativeRef",
      "type": "object"
    },
    "MediaReceipt_MediaInputEnd_": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/MediaInputEnd"
        },
        "id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "request_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "id",
        "key",
        "request_sha256",
        "body",
        "sha256"
      ],
      "title": "MediaReceipt[MediaInputEnd]",
      "type": "object"
    },
    "MediaSession": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch"
      ],
      "title": "MediaSession",
      "type": "object"
    },
    "MediaSourcePTS": {
      "additionalProperties": false,
      "properties": {
        "frame_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Index"
        },
        "pts": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Pts",
          "type": "integer"
        },
        "sample_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Count"
        },
        "sample_start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Start"
        },
        "time_base_den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Time Base Den",
          "type": "integer"
        },
        "time_base_num": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Time Base Num",
          "type": "integer"
        }
      },
      "required": [
        "pts",
        "time_base_num",
        "time_base_den",
        "sample_start",
        "sample_count",
        "frame_index"
      ],
      "title": "MediaSourcePTS",
      "type": "object"
    },
    "MediaTrackEnd": {
      "additionalProperties": false,
      "properties": {
        "last_pts": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSourcePTS"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "segment_boundary",
            "eof"
          ],
          "title": "State",
          "type": "string"
        },
        "through_source_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Through Source Seq",
          "type": "integer"
        },
        "through_track_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Through Track Seq",
          "type": "integer"
        },
        "track_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "through_track_seq",
        "through_source_seq",
        "last_pts",
        "state"
      ],
      "title": "MediaTrackEnd",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "found": {
      "title": "Found",
      "type": "boolean"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaReceipt_MediaInputEnd_"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "found",
    "value"
  ],
  "title": "MediaFound[MediaInputEnd]",
  "type": "object"
}
