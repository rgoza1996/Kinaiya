{
  "additionalProperties": false,
  "description": "Immutable canonical native initial-submit identity, never a mutable Task.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "submit_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Submit Event Id",
      "type": "string"
    },
    "submit_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Submit Sequence",
      "type": "integer"
    },
    "submit_idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Submit Idempotency Key",
      "type": "string"
    },
    "submit_payload_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Submit Payload Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "thread_id",
    "epoch",
    "task_id",
    "submit_event_id",
    "submit_sequence",
    "submit_idempotency_key",
    "submit_payload_digest"
  ],
  "title": "AgentTaskIdentity",
  "type": "object"
}
