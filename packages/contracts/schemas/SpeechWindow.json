{
  "$defs": {
    "CatalogModelBinding": {
      "additionalProperties": false,
      "description": "Explicit immutable native provider reference, never a display alias.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "generation": {
          "maximum": 64,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation",
        "configuration_sha256"
      ],
      "title": "CatalogModelBinding",
      "type": "object"
    },
    "STTModelPin": {
      "additionalProperties": false,
      "description": "Native transcription target; undeclared host identity stays unknown.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "role": {
          "const": "stt",
          "default": "stt",
          "title": "Role",
          "type": "string"
        },
        "source": {
          "enum": [
            "host",
            "catalog"
          ],
          "title": "Source",
          "type": "string"
        },
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "title": "Backend Id",
          "type": "string"
        },
        "instance_id": {
          "maxLength": 32,
          "minLength": 32,
          "title": "Instance Id",
          "type": "string"
        },
        "settings_revision": {
          "maximum": 9007199254740990,
          "minimum": 0,
          "title": "Settings Revision",
          "type": "integer"
        },
        "catalog_revision": {
          "anyOf": [
            {
              "maximum": 9007199254740990,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Catalog Revision"
        },
        "catalog_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogModelBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "local": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local"
        }
      },
      "required": [
        "source",
        "backend_id",
        "instance_id",
        "settings_revision",
        "catalog_revision",
        "catalog_binding",
        "provider",
        "model",
        "local"
      ],
      "title": "STTModelPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authenticated STT hypothesis; persistence does not depend on classification.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "utterance_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Utterance Id",
      "type": "string"
    },
    "window_index": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Window Index",
      "type": "integer"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "text": {
      "default": "",
      "maxLength": 16000,
      "title": "Text",
      "type": "string"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "user_speaking": {
      "title": "User Speaking",
      "type": "boolean"
    },
    "capture_ended": {
      "default": false,
      "title": "Capture Ended",
      "type": "boolean"
    },
    "audio_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Sha256"
    },
    "stt_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/STTModelPin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_scope": {
      "default": "local_only",
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Content Scope",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "thread_id",
    "epoch",
    "utterance_id",
    "window_index",
    "start_ms",
    "end_ms",
    "user_speaking"
  ],
  "title": "SpeechWindow",
  "type": "object"
}
