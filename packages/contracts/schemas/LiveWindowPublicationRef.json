{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "protocol": {
      "const": "live_window_publication_v2",
      "title": "Protocol",
      "type": "string"
    },
    "owner_instance": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Owner Instance",
      "type": "string"
    },
    "capture_id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Capture Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "utterance_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Utterance Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "owner_instance",
    "capture_id",
    "session_id",
    "thread_id",
    "epoch",
    "utterance_id",
    "idempotency_key",
    "request_sha256"
  ],
  "title": "LiveWindowPublicationRef",
  "type": "object"
}
