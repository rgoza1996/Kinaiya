{
  "$defs": {
    "MediaNativeRef": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "receipt_id",
        "sha256"
      ],
      "title": "MediaNativeRef",
      "type": "object"
    },
    "MediaProbeClock": {
      "additionalProperties": false,
      "properties": {
        "first_pts": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "First Pts",
          "type": "integer"
        },
        "probe_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Probe Index",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "container",
            "untimed_image"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "timebase": {
          "$ref": "#/$defs/MediaQ"
        }
      },
      "required": [
        "probe_index",
        "first_pts",
        "timebase",
        "provenance"
      ],
      "title": "MediaProbeClock",
      "type": "object"
    },
    "MediaProbeObservation": {
      "additionalProperties": false,
      "properties": {
        "child_owner": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "clocks": {
          "items": {
            "$ref": "#/$defs/MediaProbeClock"
          },
          "maxItems": 8,
          "title": "Clocks",
          "type": "array"
        },
        "probe": {
          "$ref": "#/$defs/MediaProbeResult"
        },
        "profile_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "seal": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "source": {
          "$ref": "#/$defs/MediaNativeRef"
        },
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "source",
        "seal",
        "child_owner",
        "profile_sha256",
        "probe",
        "clocks"
      ],
      "title": "MediaProbeObservation",
      "type": "object"
    },
    "MediaProbeResult": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "enum": [
            "wav",
            "mp4",
            "webm",
            "png",
            "jpeg"
          ],
          "title": "Container",
          "type": "string"
        },
        "input_bytes": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Input Bytes",
          "type": "integer"
        },
        "source_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/MediaProbeTrack"
          },
          "maxItems": 8,
          "title": "Tracks",
          "type": "array"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "source_sha256",
        "input_bytes",
        "container",
        "tracks"
      ],
      "title": "MediaProbeResult",
      "type": "object"
    },
    "MediaProbeTrack": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Channels"
        },
        "codec": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le",
            "aac",
            "opus",
            "png",
            "mjpeg",
            "h264",
            "hevc",
            "vp9",
            "av1"
          ],
          "title": "Codec",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaQ"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Height"
        },
        "index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "audio",
            "video",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        },
        "timebase": {
          "$ref": "#/$defs/MediaQ"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Width"
        }
      },
      "required": [
        "index",
        "kind",
        "codec",
        "rate",
        "channels",
        "width",
        "height",
        "timebase",
        "duration"
      ],
      "title": "MediaProbeTrack",
      "type": "object"
    },
    "MediaQ": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "MediaQ",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/MediaProbeObservation"
    },
    "id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "title": "Id",
      "type": "string"
    },
    "key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "id",
    "key",
    "request_sha256",
    "body",
    "sha256"
  ],
  "title": "MediaReceipt[MediaProbeObservation]",
  "type": "object"
}
