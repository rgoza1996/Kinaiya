{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "expected_runtime_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Expected Runtime Id",
      "type": "string"
    },
    "expected_generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Expected Generation",
      "type": "integer"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "implementation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementation Id"
    },
    "selector_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Selector Ids",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "thread_id",
    "epoch",
    "expected_runtime_id",
    "expected_generation",
    "enabled"
  ],
  "title": "MemoryUseConfigure",
  "type": "object"
}
