{
  "$defs": {
    "CatalogModelBinding": {
      "additionalProperties": false,
      "description": "Explicit immutable native provider reference, never a display alias.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "generation": {
          "maximum": 64,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation",
        "configuration_sha256"
      ],
      "title": "CatalogModelBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "host",
        "catalog"
      ],
      "title": "Source",
      "type": "string"
    },
    "catalog_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogModelBinding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "catalog_binding"
  ],
  "title": "TTSModelSelection",
  "type": "object"
}
