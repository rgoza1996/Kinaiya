{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "runtime_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Runtime Id",
      "type": "string"
    },
    "use_generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Use Generation",
      "type": "integer"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "implementation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Implementation Id"
    },
    "selector_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Selector Ids",
      "type": "array"
    },
    "pending": {
      "title": "Pending",
      "type": "boolean"
    },
    "notice": {
      "enum": [
        "disabled",
        "ready",
        "unavailable",
        "context_omitted"
      ],
      "title": "Notice",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "thread_id",
    "epoch",
    "runtime_id",
    "use_generation",
    "enabled",
    "implementation_id",
    "selector_ids",
    "pending",
    "notice"
  ],
  "title": "MemoryUseState",
  "type": "object"
}
