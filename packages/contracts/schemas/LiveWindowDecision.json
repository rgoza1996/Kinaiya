{
  "additionalProperties": false,
  "description": "Native bindings are added after validation, never accepted from a model.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversation": {
      "enum": [
        "IGNORE",
        "WAIT_FOR_NEXT_WINDOW",
        "RESPOND_INTERRUPT_USER",
        "RESPOND_WITHOUT_INTERRUPTING_USER",
        "WAIT_WITH_BACKCHANNEL"
      ],
      "title": "Conversation",
      "type": "string"
    },
    "agent_route": {
      "enum": [
        "IGNORE_FOR_IMMEDIATE_ROUTING",
        "STEER_CURRENT_TASK",
        "INTERRUPT_CURRENT_TASK",
        "QUEUE_UNTIL_TASK_DONE"
      ],
      "title": "Agent Route",
      "type": "string"
    },
    "target_task_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Task Id"
    },
    "expected_objective_revision": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Objective Revision"
    },
    "reason_code": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "utterance_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Utterance Id",
      "type": "string"
    },
    "window_index": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Window Index",
      "type": "integer"
    },
    "source_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Event Id",
      "type": "string"
    },
    "source_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Source Sequence",
      "type": "integer"
    },
    "source_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "prompt_chars": {
      "maximum": 200000,
      "minimum": 0,
      "title": "Prompt Chars",
      "type": "integer"
    },
    "history_chars": {
      "maximum": 48000,
      "minimum": 0,
      "title": "History Chars",
      "type": "integer"
    },
    "context_entries": {
      "maximum": 12,
      "minimum": 0,
      "title": "Context Entries",
      "type": "integer"
    },
    "classifier_ms": {
      "minimum": 0,
      "title": "Classifier Ms",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "conversation",
    "agent_route",
    "target_task_id",
    "expected_objective_revision",
    "reason_code",
    "decision_id",
    "session_id",
    "thread_id",
    "epoch",
    "utterance_id",
    "window_index",
    "source_event_id",
    "source_sequence",
    "source_revision",
    "prompt_chars",
    "history_chars",
    "context_entries",
    "classifier_ms"
  ],
  "title": "LiveWindowDecision",
  "type": "object"
}
