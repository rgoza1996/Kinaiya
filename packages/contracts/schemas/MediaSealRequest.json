        }
      },
      "required": [
        "backend_id",
        "receipt_id",
        "sha256"
      ],
      "title": "MediaNativeRef",
      "type": "object"
    },
    "MediaSession": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
