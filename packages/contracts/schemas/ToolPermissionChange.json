{
  "$defs": {
    "PermissionScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "default",
            "workspace",
            "session",
            "task"
          ],
          "title": "Kind",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "epoch": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "objective_revision": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Revision"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PermissionScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "expected_revision": {
      "maximum": 9007199254740990,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "expected_state": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected State",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._-]{1,128}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PermissionScope"
    },
    "tool": {
      "enum": [
        "read_file",
        "write_file",
        "shell"
      ],
      "title": "Tool",
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mode"
    }
  },
  "required": [
    "schema_version",
    "expected_revision",
    "expected_state",
    "idempotency_key",
    "scope",
    "tool",
    "mode"
  ],
  "title": "ToolPermissionChange",
  "type": "object"
}
