  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/MediaRuntime"
    },
    "id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$",
