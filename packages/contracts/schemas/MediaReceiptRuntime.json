{
  "$defs": {
    "MediaAssetPin": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "guest": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Guest",
          "type": "string"
        },
        "kind": {
          "enum": [
            "decoder_exec",
            "probe_exec",
            "sandbox_exec",
            "python_exec",
            "runtime_library",
            "driver_source"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "guest",
        "bytes",
        "sha256"
      ],
      "title": "MediaAssetPin",
      "type": "object"
    },
    "MediaCodePin": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "git_blob": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Blob",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "path",
        "git_blob",
        "sha256"
      ],
      "title": "MediaCodePin",
      "type": "object"
    },
    "MediaRuntime": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/MediaAssetPin"
          },
          "maxItems": 256,
          "title": "Assets",
          "type": "array"
        },
        "distribution_lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaCodePin"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "sealed_asset_set",
          "title": "Kind",
          "type": "string"
        },
        "manifest_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "kind",
        "manifest_sha256",
        "assets",
        "distribution_lock"
      ],
      "title": "MediaRuntime",
      "type": "object"
