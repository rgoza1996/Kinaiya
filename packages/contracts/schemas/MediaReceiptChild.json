          "type": "string"
        },
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaNativeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Instance",
          "type": "string"
        },
        "kind": {
          "enum": [
            "upload",
            "decoder",
            "converse_provider",
            "decisions_provider",
            "input_asr",
            "assistant_asr",
            "tts_provider",
            "playback",
            "agent_media",
            "agent_delivery"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
