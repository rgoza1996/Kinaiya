          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "core",
                "agent",
                "decisions",
                "agent-decisions",
                "converse-decisions",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "required": [
        "source"
      ],
      "title": "CoreSubsystemSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
