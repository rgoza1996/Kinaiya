        "STEER_CURRENT_TASK",
        "INTERRUPT_CURRENT_TASK",
        "QUEUE_UNTIL_TASK_DONE"
      ],
      "title": "Agent Route",
      "type": "string"
    },
    "target_task_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
