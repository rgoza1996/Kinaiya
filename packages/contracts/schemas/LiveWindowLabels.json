{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversation": {
      "enum": [
        "IGNORE",
        "WAIT_FOR_NEXT_WINDOW",
        "RESPOND_INTERRUPT_USER",
        "RESPOND_WITHOUT_INTERRUPTING_USER",
        "WAIT_WITH_BACKCHANNEL"
      ],
      "title": "Conversation",
      "type": "string"
    },
    "agent_route": {
