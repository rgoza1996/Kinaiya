{
  "additionalProperties": false,
  "description": "Seven required immutable fields; owner authority comes from the service.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "expected_backend": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[a-f0-9]{32}$",
      "title": "Expected Backend",
      "type": "string"
    },
    "expected_instance": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "title": "Expected Instance",
      "type": "string"
    },
    "expected_revision": {
      "maximum": 9007199254740990,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "off",
        "on_demand",
        "autonomous"
      ],
      "title": "Mode",
      "type": "string"
    },
    "active_work_policy": {
      "const": "finish_already_accepted",
      "title": "Active Work Policy",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "expected_backend",
    "expected_instance",
    "expected_revision",
    "mode",
    "active_work_policy"
  ],
  "title": "AgentModeChange",
  "type": "object"
}
