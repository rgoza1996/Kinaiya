{
  "$defs": {
    "MemoryState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "node_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Node Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ready",
            "quarantined"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch",
        "enabled",
        "revision",
        "node_count",
        "status"
      ],
      "title": "MemoryState",
      "type": "object"
    },
    "MemorySummary": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "ordinal": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "assertion",
            "observation",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "invalidated",
            "tainted",
            "forgotten"
          ],
          "title": "State",
          "type": "string"
        },
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preview"
        },
        "preview_truncated": {
          "title": "Preview Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "node_id",
        "ordinal",
        "kind",
        "state",
        "preview",
        "preview_truncated"
      ],
      "title": "MemorySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/MemoryState"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/MemorySummary"
      },
      "maxItems": 256,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "state",
    "entries"
  ],
  "title": "MemoryCatalogResult",
  "type": "object"
}
