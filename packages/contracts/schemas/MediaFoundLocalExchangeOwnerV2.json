{
  "$defs": {
    "MediaCanonicalModelPinV2": {
      "additionalProperties": false,
      "description": "Full canonical legacy pin, not an availability or permission receipt.\n\nThe byte envelope keeps legacy JSON/validation independent of media's\ninteger-only graph. Neither legacy pin schemas nor media V1 graphs change.",
      "properties": {
        "canonical_utf8_b64": {
          "maxLength": 21848,
          "minLength": 1,
          "title": "Canonical Utf8 B64",
          "type": "string"
        },
        "pin_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pin Sha256",
          "type": "string"
        },
        "role": {
          "enum": [
            "converse",
            "decisions"
          ],
          "title": "Role",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "role",
        "canonical_utf8_b64",
        "pin_sha256"
      ],
      "title": "MediaCanonicalModelPinV2",
      "type": "object"
    },
    "MediaConsumerRef": {
