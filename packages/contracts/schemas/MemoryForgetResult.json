{
  "$defs": {
    "MemoryState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "node_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Node Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ready",
            "quarantined"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "thread_id",
        "epoch",
        "enabled",
        "revision",
        "node_count",
        "status"
      ],
      "title": "MemoryState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/MemoryState"
    },
    "forgotten_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Forgotten Ids",
      "type": "array"
    }
  },
  "required": [
    "state",
    "forgotten_ids"
  ],
  "title": "MemoryForgetResult",
  "type": "object"
}
