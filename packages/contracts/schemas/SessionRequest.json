{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "channel": {
      "default": "converse",
      "enum": [
        "converse",
        "agent"
      ],
      "title": "Channel",
      "type": "string"
    },
    "name": {
      "default": "",
      "maxLength": 200,
      "title": "Name",
      "type": "string"
    },
    "harness_version": {
      "anyOf": [
        {
          "pattern": "^(seed-v1|v-[a-f0-9]{24})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness Version"
    }
  },
  "title": "SessionRequest",
  "type": "object"
}
