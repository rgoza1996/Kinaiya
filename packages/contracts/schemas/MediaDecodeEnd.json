{
  "$defs": {
    "MediaNativeRef": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "receipt_id",
        "sha256"
      ],
      "title": "MediaNativeRef",
      "type": "object"
    },
    "MediaSourcePTS": {
      "additionalProperties": false,
      "properties": {
        "frame_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Index"
        },
        "pts": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Pts",
          "type": "integer"
        },
        "sample_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Count"
        },
        "sample_start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Start"
        },
        "time_base_den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Time Base Den",
          "type": "integer"
        },
        "time_base_num": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Time Base Num",
          "type": "integer"
        }
      },
      "required": [
        "pts",
        "time_base_num",
        "time_base_den",
        "sample_start",
        "sample_count",
        "frame_index"
      ],
      "title": "MediaSourcePTS",
      "type": "object"
    },
    "MediaTrackEnd": {
      "additionalProperties": false,
      "properties": {
        "last_pts": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSourcePTS"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "segment_boundary",
            "eof"
          ],
          "title": "State",
          "type": "string"
        },
        "through_source_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Through Source Seq",
          "type": "integer"
        },
        "through_track_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Through Track Seq",
          "type": "integer"
        },
        "track_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "through_track_seq",
        "through_source_seq",
        "last_pts",
        "state"
      ],
      "title": "MediaTrackEnd",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "child_owner": {
      "$ref": "#/$defs/MediaNativeRef"
    },
    "kind": {
      "enum": [
        "segment_end",
        "source_eof"
      ],
      "title": "Kind",
      "type": "string"
    },
    "profile_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "sealed_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaNativeRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_id": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "title": "Segment Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/MediaNativeRef"
    },
    "through_packet_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Through Packet Sequence",
      "type": "integer"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/MediaTrackEnd"
      },
      "maxItems": 8,
      "title": "Tracks",
      "type": "array"
    },
    "v": {
      "const": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "segment_id",
    "source",
    "sealed_source",
    "child_owner",
    "profile_sha256",
    "kind",
    "through_packet_sequence",
    "tracks"
  ],
  "title": "MediaDecodeEnd",
  "type": "object"
}
