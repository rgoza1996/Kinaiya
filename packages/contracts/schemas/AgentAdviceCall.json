{
  "$defs": {
    "AdviceMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "AdviceMessage",
      "type": "object"
    },
    "AgentTaskIdentity": {
      "additionalProperties": false,
      "description": "Immutable canonical native initial-submit identity, never a mutable Task.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "submit_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Submit Event Id",
          "type": "string"
        },
        "submit_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Submit Sequence",
          "type": "integer"
        },
        "submit_idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Submit Idempotency Key",
          "type": "string"
        },
        "submit_payload_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Submit Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "thread_id",
        "epoch",
        "task_id",
        "submit_event_id",
        "submit_sequence",
        "submit_idempotency_key",
        "submit_payload_digest"
      ],
      "title": "AgentTaskIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "protocol": {
      "const": "measured_agent_advice_v1",
      "default": "measured_agent_advice_v1",
      "title": "Protocol",
      "type": "string"
    },
    "expected_instance": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Expected Instance",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "logical_request_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Logical Request Id",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/AgentTaskIdentity"
    },
    "objective_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "source_revisions": {
      "maxProperties": 32,
      "patternProperties": {
        "^[A-Za-z0-9_.:-]{1,128}$": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "Source Revisions",
      "type": "object"
    },
    "context_event_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Context Event Ids",
      "type": "array"
    },
    "content_scope": {
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Content Scope",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/AdviceMessage"
      },
      "maxItems": 2048,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    }
  },
  "required": [
    "expected_instance",
    "policy_sha256",
    "logical_request_id",
    "task",
    "objective_revision",
    "source_revisions",
    "content_scope",
    "messages"
  ],
  "title": "AgentAdviceCall",
  "type": "object"
}
