{
  "$defs": {
    "CatalogModelBinding": {
      "additionalProperties": false,
      "description": "Explicit immutable native provider reference, never a display alias.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "generation": {
          "maximum": 64,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation",
        "configuration_sha256"
      ],
      "title": "CatalogModelBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Actual operation target, not a readiness receipt or credential reference.",
  "properties": {
    "role": {
      "const": "converse",
      "default": "converse",
      "title": "Role",
      "type": "string"
    },
    "source": {
      "enum": [
        "host",
        "catalog"
      ],
      "title": "Source",
      "type": "string"
    },
    "settings_revision": {
      "maximum": 9007199254740990,
      "minimum": 0,
      "title": "Settings Revision",
      "type": "integer"
    },
    "catalog_revision": {
      "anyOf": [
        {
          "maximum": 9007199254740990,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Catalog Revision"
    },
    "catalog_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogModelBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "local": {
      "title": "Local",
      "type": "boolean"
    },
    "reasoning": {
      "anyOf": [
        {
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reasoning"
    }
  },
  "required": [
    "source",
    "settings_revision",
    "catalog_revision",
    "catalog_binding",
    "provider",
    "model",
    "local",
    "reasoning"
  ],
  "title": "RoleModelPin",
  "type": "object"
}
