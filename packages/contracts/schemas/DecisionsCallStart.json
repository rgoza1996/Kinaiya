{
  "$defs": {
    "CatalogModelBinding": {
      "additionalProperties": false,
      "description": "Explicit immutable native provider reference, never a display alias.",
      "properties": {
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "generation": {
          "maximum": 64,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation",
        "configuration_sha256"
      ],
      "title": "CatalogModelBinding",
      "type": "object"
    },
    "DecisionsModelPin": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[a-f0-9]{32}$",
          "title": "Backend Id",
          "type": "string"
        },
        "catalog_revision": {
          "anyOf": [
            {
              "maximum": 9007199254740990,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Catalog Revision"
        },
        "instance_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[a-f0-9]{32}$",
          "title": "Instance Id",
          "type": "string"
        },
        "local": {
          "title": "Local",
          "type": "boolean"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "laya_systemone",
            "native_d1_systemone",
            "host_configured"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "const": "decisions",
          "default": "decisions",
          "title": "Role",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/DecisionsModelSelection"
        },
        "settings_revision": {
          "maximum": 9007199254740990,
          "minimum": 0,
          "title": "Settings Revision",
          "type": "integer"
        }
      },
      "required": [
        "backend_id",
        "instance_id",
        "settings_revision",
        "selection",
        "catalog_revision",
        "provider",
        "model",
        "local",
        "protocol"
      ],
      "title": "DecisionsModelPin",
      "type": "object"
    },
    "DecisionsModelSelection": {
      "additionalProperties": false,
      "properties": {
        "catalog_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogModelBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "host",
            "catalog"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "catalog_binding"
      ],
      "title": "DecisionsModelSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Sha256"
    },
    "attempt": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "call_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Call Id",
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_pin": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionsModelPin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "request": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request"
    },
    "request_format": {
      "enum": [
        "laya_systemone",
        "native_d1_systemone",
        "chat_completions",
        "responses",
        "not_submitted",
        "reused"
      ],
      "title": "Request Format",
      "type": "string"
    },
    "reused_from_call_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reused From Call Id"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "source_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Event Id",
      "type": "string"
    },
    "source_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "source_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Source Sequence",
      "type": "integer"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    }
  },
  "required": [
    "call_id",
    "attempt_id",
    "attempt",
    "source_event_id",
    "source_sequence",
    "source_revision",
    "session_id",
    "thread_id",
    "epoch",
    "request_format"
  ],
  "title": "DecisionsCallStart",
  "type": "object"
}
