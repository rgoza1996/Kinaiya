{
  "$defs": {
    "AgentExportProviderInfo": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "local": {
          "title": "Local",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        },
        "disclosure_policy": {
          "anyOf": [
            {
              "enum": [
                "public_synthetic_only",
                "owner_authorized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Policy"
        }
      },
      "required": [
        "provider",
        "model",
        "local"
      ],
      "title": "AgentExportProviderInfo",
      "type": "object"
    },
    "AgentTaskIdentity": {
      "additionalProperties": false,
      "description": "Immutable canonical native initial-submit identity, never a mutable Task.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "submit_event_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Submit Event Id",
          "type": "string"
        },
        "submit_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Submit Sequence",
          "type": "integer"
        },
        "submit_idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Submit Idempotency Key",
          "type": "string"
        },
        "submit_payload_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Submit Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "thread_id",
        "epoch",
        "task_id",
        "submit_event_id",
        "submit_sequence",
        "submit_idempotency_key",
        "submit_payload_digest"
      ],
      "title": "AgentTaskIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "consumer": {
      "const": "agent",
      "default": "agent",
      "title": "Consumer",
      "type": "string"
    },
    "protocol": {
      "const": "measured_agent_advice_v1",
      "default": "measured_agent_advice_v1",
      "title": "Protocol",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/AgentTaskIdentity"
    },
    "objective_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Objective Revision",
      "type": "integer"
    },
    "source_revisions": {
      "maxProperties": 32,
      "patternProperties": {
        "^[A-Za-z0-9_.:-]{1,128}$": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "Source Revisions",
      "type": "object"
    },
    "context_event_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Context Event Ids",
      "type": "array"
    },
    "content_scope": {
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Content Scope",
      "type": "string"
    },
    "instruction_scope": {
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Instruction Scope",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/AgentExportProviderInfo"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "logical_request_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Logical Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "complete_count",
        "complete_generation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "request_nonce": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Request Nonce",
      "type": "string"
    }
  },
  "required": [
    "task",
    "objective_revision",
    "source_revisions",
    "content_scope",
    "instruction_scope",
    "provider",
    "policy_sha256",
    "logical_request_id",
    "request_sha256",
    "purpose",
    "request_nonce"
  ],
  "title": "AgentAdviceExportRequest",
  "type": "object"
}
