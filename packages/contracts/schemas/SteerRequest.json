{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "instruction": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "content_scope": {
      "default": "local_only",
      "enum": [
        "local_only",
        "public_synthetic",
        "private_cloud_authorized"
      ],
      "title": "Content Scope",
      "type": "string"
    },
    "expected_objective_revision": {
      "minimum": 1,
      "title": "Expected Objective Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "source_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Source Event Ids",
      "type": "array"
    }
  },
  "required": [
    "instruction",
    "expected_objective_revision",
    "idempotency_key"
  ],
  "title": "SteerRequest",
  "type": "object"
}
