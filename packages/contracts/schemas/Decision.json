{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "source_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Source Event Ids",
      "type": "array"
    },
    "source_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "route": {
      "enum": [
        "ignore",
        "queue",
        "steer",
        "interrupt"
      ],
      "title": "Route",
      "type": "string"
    },
    "target_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Task Id"
    },
    "expected_objective_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Objective Revision"
    },
    "instruction": {
      "default": "",
      "maxLength": 16000,
      "title": "Instruction",
      "type": "string"
    },
    "reason_code": {
      "default": "classified",
      "maxLength": 120,
      "title": "Reason Code",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "source_event_ids",
    "route",
    "idempotency_key"
  ],
  "title": "Decision",
  "type": "object"
}
